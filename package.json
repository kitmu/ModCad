{
  "name": "modcad",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @modcad/web dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r --if-present --workspace-concurrency=1 run test",
    "test:watch": "vitest",
    "test:coverage": "pnpm -r --if-present run test -- --coverage",
    "test:e2e": "pnpm --filter @modcad/web test:e2e",
    "bench": "pnpm --filter @modcad/web bench"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "eslint": "9.18.0",
    "@eslint/js": "9.18.0",
    "typescript-eslint": "8.20.0",
    "eslint-plugin-boundaries": "5.0.1",
    "prettier": "3.4.2",
    "vitest": "1.6.1",
    "@vitest/coverage-v8": "1.6.1",
    "fast-check": "3.23.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
