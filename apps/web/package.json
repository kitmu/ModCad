{
  "name": "@modcad/web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "bench": "node ../../benchmarks/run.mjs",
    "i18n:extract": "formatjs extract 'src/**/*.tsx' 'src/**/*.ts' --ignore='**/*.d.ts' --ignore='**/*.test.*' --out-file src/i18n/extracted.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "i18n:audit": "node ../../tooling/i18n-audit.mjs",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "check:bundle": "node ../../tooling/check-bundle.mjs"
  },
  "dependencies": {
    "@modcad/codecs": "workspace:*",
    "@modcad/core": "workspace:*",
    "@modcad/renderer": "workspace:*",
    "@modcad/ui-kit": "workspace:*",
    "immer": "10.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intl": "6.6.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.0",
    "@formatjs/cli": "6.2.7",
    "@playwright/test": "1.56.1",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "@webgpu/types": "0.1.52",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "rollup-plugin-visualizer": "5.12.0",
    "tailwindcss": "3.4.17",
    "vite": "5.4.21"
  }
}
